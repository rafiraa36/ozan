/* ------------ member form dialog ------------ */
function MemberFormDialog({ open, initial, divisions, onCancel, onSave }) {
  const [form, setForm] = useState(initial || {});
  useEffect(() => { setForm(initial || { name: "", username: "", division: divisions[0]?.id, jabatan: "Anggota", status: "aktif" }); }, [initial, open]);
  if (!open) return null;
  const set = (k, v) => setForm((f) => ({ ...f, [k]: v }));
  return (
    <div className="aej-overlay" onClick={onCancel}>
      <div className="aej-dialog" onClick={(e) => e.stopPropagation()}>
        <button className="aej-dialog-close" onClick={onCancel}><X size={18} /></button>
        <h3 style={{ margin: "0 0 14px", fontFamily: "Poppins, sans-serif" }}>{initial?.id ? "Edit Anggota" : "Tambah Anggota"}</h3>
        <label className="aej-label">Nama lengkap</label>
        <input className="aej-input" value={form.name || ""} onChange={(e) => set("name", e.target.value)} />
        <label className="aej-label" style={{ marginTop: 10 }}>Username</label>
        <input className="aej-input" value={form.username || ""} onChange={(e) => set("username", e.target.value)} disabled={!!initial?.id} />
        <div style={{ display: "flex", gap: 10, marginTop: 10 }}>
          <div style={{ flex: 1 }}>
            <label className="aej-label">Divisi</label>
            <select className="aej-input" value={form.division || ""} onChange={(e) => set("division", e.target.value)}>
              {divisions.map((d) => <option key={d.id} value={d.id}>{d.name}</option>)}
            </select>
          </div>
          <div style={{ flex: 1 }}>
            <label className="aej-label">Jabatan</label>
            <input className="aej-input" value={form.jabatan || ""} onChange={(e) => set("jabatan", e.target.value)} />
          </div>
        </div>
        <label className="aej-label" style={{ marginTop: 10 }}>Status keanggotaan</label>
        <select className="aej-input" value={form.status || "aktif"} onChange={(e) => set("status", e.target.value)}>
          <option value="aktif">Aktif</option>
          <option value="nonaktif">Nonaktif</option>
        </select>
        <div style={{ display: "flex", justifyContent: "flex-end", gap: 8, marginTop: 18 }}>
          <button className="aej-btn-ghost" onClick={onCancel}>Batal</button>
          <button className="aej-btn-primary" onClick={() => onSave(form)} disabled={!form.name || !form.username || !form.division}>Simpan</button>
        </div>
