function Avatar({ name, size = 40 }) {
  const initials = (name || "?").split(" ").filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
  return (
    <div style={{
      width: size, height: size, borderRadius: "50%", background: "linear-gradient(135deg,#0F1B3D,#1B2E5C)",
      color: "#E9C55B", display: "flex", alignItems: "center", justifyContent: "center",
      fontWeight: 700, fontSize: size * 0.38, fontFamily: "Poppins, sans-serif", flexShrink: 0, border: "2px solid #E9C55B"
    }}>{initials}</div>
  );
}

function StatusPill({ status }) {
  const map = {
    aktif: { bg: "#E7F5EC", fg: "#1E7A42" },
    nonaktif: { bg: "#F1F2F5", fg: "#6b7280" },
  };
  const s = map[status] || map.nonaktif;
  return <span style={{ background: s.bg, color: s.fg, fontSize: 11.5, fontWeight: 600, padding: "3px 9px", borderRadius: 20 }}>{status === "aktif" ? "Aktif" : "Nonaktif"}</span>;
}

