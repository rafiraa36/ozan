    setToasts((t) => [...t, { id, title, desc, type }]);
    setTimeout(() => setToasts((t) => t.filter((x) => x.id !== id)), 4200);
  }, []);
  const closeToast = (id) => setToasts((t) => t.filter((x) => x.id !== id));

  // boot: seed + load session
  useEffect(() => {
    (async () => {
      let u = await dbGetUsers();
      if (!u) { u = SEED_USERS; await dbSaveUsers(u); }
      let d = await dbGetDivisions();
      if (!d) { d = DIVISIONS_SEED; await dbSaveDivisions(d); }
      setUsers(u); setDivisions(d);
      const s = await dbGetSession();
      if (s?.userId) {
        const found = u.find((x) => x.id === s.userId);
        if (found) setSession(found);
      }
      setBooting(false);
    })();
  }, []);

  const handleLogin = async (username, password) => {
    setLoginError("");
    if (!username || !password) { setLoginError("Username dan password wajib diisi."); return; }
    setLoginLoading(true);
    await new Promise((r) => setTimeout(r, 350));
    const found = users.find((u) => u.username.toLowerCase() === username.trim().toLowerCase());
    if (!found || found.password !== simpleHash(password)) {
      setLoginLoading(false);
      setLoginError("Username atau password salah.");
      return;
    }
    if (found.status === "nonaktif") {
      setLoginLoading(false);
      setLoginError("Akun ini nonaktif. Hubungi Ketua Umum atau Pembina.");
      return;
    }
    await dbSaveSession(found.id);
    setSession(found);
    setLoginLoading(false);
    setShowLogin(false);
    setActiveMenu("dashboard");
    pushToast("Login berhasil", `Selamat datang, ${found.name}.`);
  };

  const handleLogout = async () => {
    await dbClearSession();
    setSession(null);
    pushToast("Berhasil keluar", "Sampai jumpa lagi!");
  };

  const persistUsers = async (next) => {
    setUsers(next);
    await dbSaveUsers(next);
  };

  const saveMember = async (form) => {
    if (form.id) {
      const next = users.map((u) => (u.id === form.id ? { ...u, ...form } : u));
      await persistUsers(next);
      if (session?.id === form.id) setSession((s) => ({ ...s, ...form }));
      pushToast("Anggota diperbarui", `${form.name} berhasil disimpan.`);
    } else {
      if (users.some((u) => u.username.toLowerCase() === form.username.toLowerCase())) {
        pushToast("Username sudah dipakai", "Gunakan username lain.", "error");
        return;
      }
      const tempPw = "Aej" + Math.floor(1000 + Math.random() * 9000);
      const newUser = { id: "u-" + Math.random().toString(36).slice(2, 9), role: "anggota", password: simpleHash(tempPw), createdAt: new Date().toISOString().slice(0, 10), ...form };
      await persistUsers([...users, newUser]);
      pushToast("Anggota ditambahkan", `Password sementara: ${tempPw} (sampaikan ke anggota, minta segera diganti).`);
    }
    setMemberDialog({ open: false, initial: null });
  };

  const askDeactivate = (member) => {
    setConfirmState({
      open: true,
      title: member.status === "aktif" ? "Nonaktifkan anggota?" : "Aktifkan kembali anggota?",
      desc: `${member.name} akan diubah statusnya menjadi ${member.status === "aktif" ? "Nonaktif" : "Aktif"}.`,
      danger: member.status === "aktif",
      onConfirm: async () => {
        const next = users.map((u) => (u.id === member.id ? { ...u, status: u.status === "aktif" ? "nonaktif" : "aktif" } : u));
        await persistUsers(next);
        setConfirmState({ open: false });
        pushToast("Status diperbarui", `${member.name} sekarang ${member.status === "aktif" ? "nonaktif" : "aktif"}.`);
      },
    });
  };

  const changePassword = async () => {
    if (!pwForm.current || !pwForm.next || !pwForm.confirm) { pushToast("Lengkapi form", "Semua kolom wajib diisi.", "error"); return; }
    if (session.password !== simpleHash(pwForm.current)) { pushToast("Password lama salah", "", "error"); return; }
    if (pwForm.next !== pwForm.confirm) { pushToast("Konfirmasi tidak cocok", "", "error"); return; }
    const next = users.map((u) => (u.id === session.id ? { ...u, password: simpleHash(pwForm.next) } : u));
    await persistUsers(next);
    setSession((s) => ({ ...s, password: simpleHash(pwForm.next) }));
    setPwForm({ current: "", next: "", confirm: "" });
    pushToast("Password diganti", "Gunakan password baru untuk login berikutnya.");
  };

  const stats = useMemo(() => {
    const anggota = users.filter((u) => u.role === "anggota");
    return {
      totalAnggota: anggota.length,
      aktif: anggota.filter((u) => u.status === "aktif").length,
      totalDivisi: divisions.length,
    };
  }, [users, divisions]);

  const filteredMembers = useMemo(() => {
    const anggota = users.filter((u) => u.role !== "pembina");
    if (!search.trim()) return anggota;
    const q = search.toLowerCase();
    return anggota.filter((u) => u.name.toLowerCase().includes(q) || u.username.toLowerCase().includes(q) || (u.division || "").includes(q));
  }, [users, search]);

  if (booting) {
    return (
      <div style={{ minHeight: 480, display: "flex", alignItems: "center", justifyContent: "center", flexDirection: "column", gap: 10, fontFamily: "Montserrat, sans-serif" }}>
        <GlobalStyle />
        <Loader2 size={26} className="aej-spin" color="#0F1B3D" />
        <p style={{ color: "#5b6272", fontSize: 13.5 }}>Menyiapkan AEJ Management System…</p>
      </div>
    );
  }

  if (!session) {
    return (
      <div className="aej-root">
        <GlobalStyle />
        <LandingPage onLoginClick={() => { setShowLogin(true); setLoginError(""); }} divisions={divisions} />
        {showLogin && <LoginModal onClose={() => setShowLogin(false)} onLogin={handleLogin} loading={loginLoading} error={loginError} />}
        <Toast toasts={toasts} onClose={closeToast} />
      </div>
    );
  }

  const divisionName = (id) => divisions.find((d) => d.id === id)?.name || "—";

  return (
    <div className="aej-root aej-app">
      <GlobalStyle />
      <Sidebar role={session.role} active={activeMenu} onSelect={setActiveMenu} open={sidebarOpen} onClose={() => setSidebarOpen(false)} />
      <div className="aej-main">
        <Topbar user={session} onBurger={() => setSidebarOpen(true)} onLogout={handleLogout} />
        <div className="aej-content">

          {activeMenu === "dashboard" && session.role === "anggota" && (
            <>
              <h1 className="aej-page-title">Dashboard Saya</h1>
              <div className="aej-profile-banner">
                <Avatar name={session.name} size={58} />
                <div>
                  <p style={{ margin: 0, fontWeight: 700, fontSize: 16, fontFamily: "Poppins, sans-serif" }}>{session.name}</p>
                  <p style={{ margin: "2px 0 0", fontSize: 13, color: "#5b6272" }}>{divisionName(session.division)} &middot; {session.jabatan}</p>
                  <div style={{ marginTop: 6 }}><StatusPill status={session.status} /></div>
                </div>
              </div>
              <div className="aej-stat-grid">
                <StatCard label="Total Tugas" value={0} icon={LayoutDashboard} />
                <StatCard label="Rata-rata Nilai" value="—" icon={ShieldCheck} />
                <StatCard label="Persentase Kehadiran" value="—" icon={CalendarDays} />
                <StatCard label="Jumlah Karya" value={0} icon={ImageIcon} />
              </div>
              <div className="aej-card" style={{ marginTop: 18 }}>
                <EmptyState icon={LayoutDashboard} title="Belum ada data tugas, nilai, atau absensi"
                  desc="Fitur Materi, Tugas, Penilaian, dan Absensi akan aktif pada Phase 2 pengembangan." />
              </div>
            </>
          )}

          {activeMenu === "dashboard" && session.role === "ketua_umum" && (
            <>
              <h1 className="aej-page-title">Dashboard Ketua Umum</h1>
              <div className="aej-stat-grid">
                <StatCard label="Total Anggota" value={stats.totalAnggota} icon={Users} />
                <StatCard label="Anggota Aktif" value={stats.aktif} icon={ShieldCheck} />
                <StatCard label="Total Divisi" value={stats.totalDivisi} icon={Building2} />
                <StatCard label="Rata-rata Nilai AEJ" value="—" icon={LayoutDashboard} />
              </div>
              <div className="aej-card" style={{ marginTop: 18 }}>
                <EmptyState title="Modul Tugas, Penilaian, Absensi & Raport belum aktif" desc="Menyusul pada Phase 2–4 sesuai urutan pembangunan." />
              </div>
            </>
          )}

          {activeMenu === "dashboard" && session.role === "pembina" && (
            <>
              <h1 className="aej-page-title">Dashboard Pembina</h1>
              <div className="aej-stat-grid">
                <StatCard label="Total Anggota" value={stats.totalAnggota} icon={Users} />
                <StatCard label="Total Divisi" value={stats.totalDivisi} icon={Building2} />
                <StatCard label="Rata-rata Nilai AEJ" value="—" icon={ShieldCheck} />
                <StatCard label="Persentase Capaian Passing Grade" value="—" icon={LayoutDashboard} />
              </div>
              <div className="aej-card" style={{ marginTop: 18 }}>
                <EmptyState title="Data monitoring lengkap menyusul" desc="Statistik performa divisi aktif setelah modul Tugas & Penilaian dibangun (Phase 2)." />
              </div>
            </>
          )}

          {activeMenu === "anggota" && (session.role === "ketua_umum" || session.role === "pembina") && (
            <>
              <div style={{ display: "flex", flexWrap: "wrap", gap: 10, alignItems: "center", justifyContent: "space-between" }}>
                <h1 className="aej-page-title" style={{ margin: 0 }}>{session.role === "ketua_umum" ? "Kelola Anggota" : "Data Anggota"}</h1>
                {session.role === "ketua_umum" && (
                  <button className="aej-btn-primary" onClick={() => setMemberDialog({ open: true, initial: null })}><Plus size={16} /> Tambah Anggota</button>
                )}
              </div>
              <div className="aej-search-bar">
                <Search size={16} color="#8a92a3" />
                <input placeholder="Cari nama, username, atau divisi…" value={search} onChange={(e) => setSearch(e.target.value)} />
              </div>
              <div className="aej-table-wrap">
                <table className="aej-table">
                  <thead><tr><th>Nama</th><th>Username</th><th>Divisi</th><th>Jabatan</th><th>Status</th>{session.role === "ketua_umum" && <th>Aksi</th>}</tr></thead>
                  <tbody>
                    {filteredMembers.map((m) => (
                      <tr key={m.id}>
                        <td><div style={{ display: "flex", alignItems: "center", gap: 8 }}><Avatar name={m.name} size={28} />{m.name}</div></td>
                        <td>{m.username}</td>
                        <td>{divisionName(m.division)}</td>
                        <td>{m.jabatan}</td>
                        <td><StatusPill status={m.status} /></td>
                        {session.role === "ketua_umum" && (
                          <td>
                            <div style={{ display: "flex", gap: 6 }}>
                              <button className="aej-icon-btn" onClick={() => setMemberDialog({ open: true, initial: m })}><Pencil size={14} /></button>
                              <button className="aej-icon-btn" onClick={() => askDeactivate(m)}><Trash2 size={14} /></button>
                            </div>
                          </td>
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
                {filteredMembers.length === 0 && <EmptyState title="Tidak ada anggota ditemukan" desc="Coba kata kunci lain." />}
              </div>
            </>
          )}

          {activeMenu === "divisi" && (
            <>
              <h1 className="aej-page-title">Divisi AEJ</h1>
              <div className="aej-grid-5">
                {divisions.map((d) => {
                  const count = users.filter((u) => u.division === d.id).length;
                  return (
                    <div key={d.id} className="aej-div-card">
                      <h3>{d.name}</h3>
                      <p>{d.desc}</p>
                      <p style={{ marginTop: 10, fontSize: 12.5, color: "#0F1B3D", fontWeight: 600 }}>{count} anggota</p>
                    </div>
                  );
                })}
              </div>
            </>
          )}

          {activeMenu === "profil" && (
            <>
              <h1 className="aej-page-title">Profil Saya</h1>
              <div className="aej-profile-banner">
                <Avatar name={session.name} size={58} />
                <div>
                  <p style={{ margin: 0, fontWeight: 700, fontSize: 16, fontFamily: "Poppins, sans-serif" }}>{session.name}</p>
                  <p style={{ margin: "2px 0 0", fontSize: 13, color: "#5b6272" }}>{ROLE_LABEL[session.role]}{session.division ? ` · ${divisionName(session.division)}` : ""}</p>
                </div>
              </div>
              <div className="aej-card" style={{ marginTop: 16 }}>
                <div className="aej-detail-row"><span>Username</span><b>{session.username}</b></div>
                <div className="aej-detail-row"><span>Jabatan</span><b>{session.jabatan}</b></div>
                <div className="aej-detail-row"><span>Status Keanggotaan</span><StatusPill status={session.status} /></div>
                <div className="aej-detail-row"><span>Bergabung sejak</span><b>{session.createdAt}</b></div>
              </div>
            </>
          )}

          {activeMenu === "pengaturan" && (
            <>
              <h1 className="aej-page-title">Pengaturan</h1>
              <div className="aej-card" style={{ maxWidth: 420 }}>
                <h3 style={{ marginTop: 0, fontFamily: "Poppins, sans-serif", fontSize: 15 }}>Ganti Password</h3>
                <label className="aej-label">Password saat ini</label>
                <input className="aej-input" type="password" value={pwForm.current} onChange={(e) => setPwForm((f) => ({ ...f, current: e.target.value }))} />
                <label className="aej-label" style={{ marginTop: 10 }}>Password baru</label>
                <input className="aej-input" type="password" value={pwForm.next} onChange={(e) => setPwForm((f) => ({ ...f, next: e.target.value }))} />
                <label className="aej-label" style={{ marginTop: 10 }}>Konfirmasi password baru</label>
                <input className="aej-input" type="password" value={pwForm.confirm} onChange={(e) => setPwForm((f) => ({ ...f, confirm: e.target.value }))} />
                <button className="aej-btn-primary" style={{ marginTop: 14 }} onClick={changePassword}>Simpan Password</button>
              </div>
              <button className="aej-btn-ghost" style={{ marginTop: 16 }} onClick={handleLogout}><LogOut size={15} /> Keluar dari akun</button>
            </>
          )}

        </div>
      </div>

      <MemberFormDialog open={memberDialog.open} initial={memberDialog.initial} divisions={divisions}
        onCancel={() => setMemberDialog({ open: false, initial: null })} onSave={saveMember} />
      <ConfirmDialog open={confirmState.open} title={confirmState.title} desc={confirmState.desc} danger={confirmState.danger}
        onConfirm={confirmState.onConfirm} onCancel={() => setConfirmState({ open: false })} />
      <Toast toasts={toasts} onClose={closeToast} />
    </div>
  );
}

