/* ---------------- storage helpers ---------------- */
async function dbGetUsers() {
  try {
    const r = await window.storage.get("aej_users", true);
    return JSON.parse(r.value);
  } catch (e) { return null; }
}
async function dbSaveUsers(users) {
  await window.storage.set("aej_users", JSON.stringify(users), true);
}
async function dbGetDivisions() {
  try {
    const r = await window.storage.get("aej_divisions", true);
    return JSON.parse(r.value);
  } catch (e) { return null; }
}
async function dbSaveDivisions(divisions) {
  await window.storage.set("aej_divisions", JSON.stringify(divisions), true);
}
async function dbGetSession() {
  try {
    const r = await window.storage.get("aej_session", false);
    return JSON.parse(r.value);
  } catch (e) { return null; }
}
async function dbSaveSession(userId) {
  await window.storage.set("aej_session", JSON.stringify({ userId }), false);
}
async function dbClearSession() {
  try { await window.storage.delete("aej_session", false); } catch (e) { /* noop */ }
}

/* ---------------- small UI atoms ---------------- */
function Toast({ toasts, onClose }) {
  return (
    <div style={{ position: "fixed", top: 16, right: 16, zIndex: 200, display: "flex", flexDirection: "column", gap: 8, maxWidth: 340 }}>
      {toasts.map((t) => (
        <div key={t.id} className="aej-toast" style={{ borderLeftColor: t.type === "error" ? "#B3261E" : t.type === "warn" ? "#C9A227" : "#0F1B3D" }}>
          <div style={{ flex: 1 }}>
            <p style={{ margin: 0, fontWeight: 600, fontSize: 13.5 }}>{t.title}</p>
            {t.desc && <p style={{ margin: "2px 0 0", fontSize: 12.5, color: "#5b6272" }}>{t.desc}</p>}
          </div>
          <button onClick={() => onClose(t.id)} className="aej-toast-close" aria-label="Tutup notifikasi"><X size={14} /></button>
        </div>
      ))}
    </div>
  );
}

function ConfirmDialog({ open, title, desc, confirmLabel = "Ya, lanjutkan", danger, onConfirm, onCancel }) {
